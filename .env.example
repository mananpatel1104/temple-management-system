# -----------------------------------------------------------------------
# Shree Swaminarayan Mandir PWA — Environment Variables
# Copy this file to ".env" for local development and NEVER commit ".env".
# All variables consumed by client code MUST be prefixed with VITE_
# (Vite only exposes prefixed variables to the browser bundle).
# -----------------------------------------------------------------------

# Supabase project credentials (Project Settings -> API in Supabase Dashboard)
# The anon/public key is safe for client-side use; Row Level Security (RLS)
# policies in the database enforce actual access control.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# App metadata
VITE_APP_NAME="Shree Swaminarayan Mandir"
VITE_APP_ENV=development

# GitHub Pages deployment base path (must equal "/<repo-name>/" in production
# builds; keep as "/" for local development). Set the production value as a
# repository/environment variable in the GitHub Actions workflow, not here.
VITE_BASE_PATH=/

# -----------------------------------------------------------------------
# Supabase Edge Function secrets (Task 9 — Authentication/RBAC/Audit)
# -----------------------------------------------------------------------
# These are NOT read by Vite/the client bundle. They are server-side
# secrets for supabase/functions/*, configured with:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=... AUTH_JWT_SECRET=... BOOTSTRAP_SETUP_TOKEN=...
# Listed here only for deployment reference; do not add a VITE_ prefix to
# any of these or they would be bundled into the client and leaked.
#
# SUPABASE_URL                 — same project URL as VITE_SUPABASE_URL,
#                                 auto-provided by the Supabase platform
#                                 to every Edge Function at runtime.
# SUPABASE_SERVICE_ROLE_KEY    — Project Settings -> API -> service_role
#                                 key. Bypasses RLS; never expose to the
#                                 client. Auto-provided by Supabase.
# AUTH_JWT_SECRET               — a long random string (32+ bytes) used to
#                                 sign/verify editor session tokens
#                                 (supabase/functions/_shared/jwt.ts).
#                                 Generate with e.g. `openssl rand -hex 32`.
# BOOTSTRAP_SETUP_TOKEN         — a one-time long random string used only
#                                 by supabase/functions/bootstrap-admin to
#                                 create the first Supreme Administrator.
#                                 Rotate/remove it immediately after use.
